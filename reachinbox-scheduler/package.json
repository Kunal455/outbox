{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "ReachInbox Full-Stack Email Job Scheduler (Outbox Labs Assignment)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run dev:server",
    "dev:worker": "npm --prefix backend run dev:worker",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "reindex": "npm --prefix backend run reindex",
    "reconcile": "npm --prefix backend run reconcile"
  }
}
