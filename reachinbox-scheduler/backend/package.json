{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "description": "ReachInbox Email Job Scheduler Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/emailWorkerProcess.ts",
    "build": "tsc",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/workers/emailWorkerProcess.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:jest": "jest --runInBand --detectOpenHandles --forceExit",
    "reindex": "tsx src/scripts/reindexElasticsearch.ts",
    "reconcile": "tsx src/scripts/reconcileOutbox.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.13",
    "@bull-board/express": "^6.7.13",
    "@elastic/elasticsearch": "^8.17.0",
    "@prisma/client": "^5.22.0",
    "@slack/web-api": "^7.8.0",
    "bullmq": "^5.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
