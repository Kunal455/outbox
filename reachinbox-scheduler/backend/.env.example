# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reachinbox

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ & Scheduler Settings
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Nodemailer / Ethereal Email SMTP
# Leave empty to automatically generate and persist an Ethereal test account on first run
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Security & Authentication
JWT_SECRET=reachinbox_super_secret_jwt_key_2026_dev_secure
COOKIE_SECRET=reachinbox_super_secret_cookie_key_2026_dev
# 32-byte hex encryption key for AES-256 token storage
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 Credentials (obtain from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack App OAuth Credentials (obtain from api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback
SLACK_SIGNING_SECRET=
